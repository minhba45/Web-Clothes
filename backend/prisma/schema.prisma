generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum DiscountType {
  PERCENT
  FIXED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model User {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(100)
  email          String   @unique @db.VarChar(150)
  passwordHashed String
  role           Role     @default(USER)
  address        String?
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cart           Cart?
  orders         Order[]

  @@map("users")
}
model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?
  products    Product[]

  @@map("categories")
}

model Product {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  name        String   @db.VarChar(200)
  description String?
  price       Decimal  @db.Decimal(12, 2)
  imageUrl    String?
  galleryUrls String[] @default([])
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[] 

  @@index([name])
  @@map("products")
}
model ProductVariant {
  id        Int      @id @default(autoincrement())
  productId Int
  size      String   @db.VarChar(10) // S, M, L, XL...
  color     String   @db.VarChar(50) // Đỏ, Đen, Trắng...
  stock     Int      @default(0)     // Tồn kho thực tế của size/màu này
  sku       String?  @unique         // Mã vạch/Mã quản lý kho (Optional)

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  cartItems CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, color]) 
  @@map("product_variants")
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id               Int      @id @default(autoincrement())
  cartId           Int
  productVariantId Int      // Trỏ về Variant thay vì Product chung chung
  quantity         Int

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productVariantId])
  @@index([cartId])
  @@map("cart_items")
}

model Voucher {
  id            Int          @id @default(autoincrement())
  code          String       @unique @db.VarChar(50)
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)
  minOrderValue Decimal      @default(0) @db.Decimal(12, 2)
  maxDiscount   Decimal?     @db.Decimal(12, 2)
  quantity      Int          @default(1)
  isActive      Boolean      @default(true)
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  orders        Order[]

  @@index([code])
  @@map("vouchers")
}

model Order {
  id              Int           @id @default(autoincrement())
  userId          Int
  voucherId       Int?
  subtotal        Decimal       @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID) // Thêm trạng thái thanh toán
  paymentMethod   String        @default("COD")  // Ví dụ: COD, VNPAY, MOMO
  shippingAddress String

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  voucher         Voucher?      @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  items           OrderItem[]

  @@index([userId])
  @@index([voucherId])
  @@map("orders")
}

model OrderItem {
  id               Int      @id @default(autoincrement())
  orderId          Int
  productVariantId Int      // Biết chính xác khách mua màu gì, size gì
  quantity         Int
  priceAtPurchase  Decimal  @db.Decimal(12, 2)

  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}